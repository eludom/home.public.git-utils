#! /bin/bash
# Do various status operatons on git diretories
#
# Usage: gitstat [-f] [-s|-u|-r] dir [dir...]
#
# -f     - Fetch first
# -r     - Show remotes
# -s     - Show short file status
# -u     - print fetch url
# [NONE] - no aguments, just show how many commits ahead/behind

set -e;

fetch=false
status=false
url=false
remotes=false

PROG=`basename "$0" | tr -d '\n'`

function show_usage() {
    echo "Usage: $PROG [--help] [-f] [-s|-u|-r] [dir[dir...]]"

    cat <<EOF

  -f|--fetch       - Fetch first
  -r|--remotes     - Show remotes
  -s|--status      - Show short file status
  -u|--url         - print fetch url
  [NONE] - no aguments, just show how many commits ahead/behind
EOF
    exit 1
}

while [ ! -z "$1" ];do
   case "$1" in
        -h|--help)
          show_usage
          ;;
        -f|--fetch)
          fetch="true"
          ;;
        -r|--remotes)
          remotes="true"
          ;;
        -s|--status)
          status="true"
          ;;
        -u|--url)
          url="true"
          ;;
        *)
            if [[ "$1" =~ ^- ]]; then
                echo unknown flag $1
                show_usage
            else
                break
            fi
   esac
shift
done

ARGC=$#

if [ "$ARGC" == "0" ]; then
    set -- `pwd` "$@" # add pwd if no args
fi

for i in $* ; do
    if [ "$fetch" == "true" ]; then
        git fetch
    fi

    \pushd $i > /dev/null;

    if [ "$url" == "true" ]; then
        git remote -v | grep fetch  | sed 's#.*ssh#ssh#;s# (fetch)##'
    elif [ "$remotes" == "true" ]; then
        git remote -v
    elif [ "$status" == "true" ]; then
        echo $i;
        git branch -vv;
        git status -s
        echo;
    else
        echo $i;
        git branch -vv;
        echo;

    fi
    \popd > /dev/null;
done
